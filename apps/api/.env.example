# Modèle de configuration de l'API. Copier en `.env` et remplir.
# `.env` est ignoré par git — aucune valeur réelle ne doit se retrouver ici.
#
# Chargé par `--env-file=.env` dans les scripts `dev` et `start`.
# Les clés PEM tiennent sur une ligne, avec des `\n` littéraux : le serveur les
# reconvertit en vrais sauts de ligne.

# Attention au port : une machine peut héberger plusieurs instances PostgreSQL,
# et 5432 n'est pas forcément celle qu'on croit. `pg_lsclusters` sous Linux,
# la ligne `port =` de `postgresql.conf` sous Windows.
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@127.0.0.1:5432/lonlonbenu

# Clé RSA de signature des jetons d'accès (JWT RS256). En développement,
# n'importe quelle clé PKCS#8 fait l'affaire ; en production elle doit être
# unique, secrète, et différente de celle de développement.
LONLONBENU_CLE_PRIVEE_PEM="-----BEGIN PRIVATE KEY-----\n…\n-----END PRIVATE KEY-----\n"

LONLONBENU_OAUTH_EMETTEUR=https://auth.lonlonbenu.local
LONLONBENU_OAUTH_AUDIENCE=lonlonbenu-api
LONLONBENU_OAUTH_CLIENTS=lonlonbenu-mobile

# Déclencheur externe de rappels. Sans lui, la route /taches/rappels n'existe
# pas — le planificateur interne suffit tant qu'il n'y a qu'une instance.
# LONLONBENU_SECRET_TACHES=

# Suivi des erreurs. Sans DSN, rien n'est initialisé et le module ne coûte
# rien : c'est ce qui permet de livrer le câblage avant que le compte n'existe.
# SENTRY_DSN=
# LONLONBENU_ENVIRONNEMENT=production

# --- Notifications push -------------------------------------------------
# Android / Firebase : les trois champs viennent du JSON de compte de service
# (console Firebase → Paramètres du projet → Comptes de service).
LONLONBENU_FCM_PROJET_ID=
LONLONBENU_FCM_COURRIEL_COMPTE_SERVICE=
LONLONBENU_FCM_CLE_PRIVEE_PEM=

# iOS / Apple : clé .p8 du compte développeur.
# LONLONBENU_APNS_CLE_P8=
# LONLONBENU_APNS_ID_CLE=
# LONLONBENU_APNS_ID_EQUIPE=
# LONLONBENU_APNS_SUJET=com.lonlonbenu.app
# Non défini = bac à sable. "true" seulement pour un build App Store.
# LONLONBENU_APNS_PRODUCTION=
