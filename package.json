{
  "name": "lonlonbenu",
  "version": "0.1.0",
  "private": true,
  "description": "LONLONBENU — l'application hub du couple",
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=@lonlonbenu/mobile",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "eas-cli": "^21.8.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
